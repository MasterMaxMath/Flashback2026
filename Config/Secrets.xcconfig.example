// Copy this file to Secrets.xcconfig (same folder) and paste your key.
// Secrets.xcconfig is gitignored — never commit a real key.
GEMINI_API_KEY = PASTE_KEY_HERE
// Cloudflare Workers AI (for scene images): Account ID from the dashboard
// sidebar, API token from Manage Account → API Tokens (Workers AI template).
CLOUDFLARE_ACCOUNT_ID = PASTE_ACCOUNT_ID_HERE
CLOUDFLARE_API_TOKEN = PASTE_TOKEN_HERE
